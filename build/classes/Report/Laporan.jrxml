	<queryString language="SQL">
		<![CDATA[SELECT sekolah_smp.anggota.idanggota,
	sekolah_smp.anggota.nama,
	sekolah_smp.anggota.nis,
	sekolah_smp.anggota.kelas,
	sekolah_smp.laporan.laporan
FROM sekolah_smp.laporan
	INNER JOIN sekolah_smp.anggota ON 
	 sekolah_smp.laporan.idlaporan = sekolah_smp.anggota.idanggota]]>
	</queryString>
