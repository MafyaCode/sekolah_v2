	<queryString language="SQL">
		<![CDATA[SELECT sekolah_smp.anggota.idanggota,
	sekolah_smp.anggota.nama,
	sekolah_smp.anggota.nis,
	sekolah_smp.anggota.kelas,
	sekolah_smp.rekomendasi.rekomendasi
FROM sekolah_smp.rekomendasi
	INNER JOIN sekolah_smp.anggota ON 
	 sekolah_smp.rekomendasi.idrekomendasi = sekolah_smp.anggota.idanggota]]>
	</queryString>
