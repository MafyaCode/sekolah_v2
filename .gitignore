# Directories generated by NetBeans/Ant and project build process
build/
dist/
nbbuild/
nbdist/

# NetBeans specific private files (contains user-specific settings)
nbproject/private/

# Log files and other temporary files
*.log
*.swp
*~
*.bak

# Operating System generated files
.DS_Store # macOS
Thumbs.db # Windows
desktop.ini # Windows

# IDE specific files (if you or collaborators use other IDEs)
.idea/ # IntelliJ IDEA
*.iml # IntelliJ IDEA
*.ipr # IntelliJ IDEA
*.iws # IntelliJ IDEA
.classpath # Eclipse
.project # Eclipse
.settings/ # Eclipse

# Jar files that are part of the build, but not source
# (Assuming your 'lib/' folder contains all necessary jars you want to commit)
# Jika folder 'lib/' TIDAK ingin di-commit, HAPUS tanda '#' di baris di bawah:
# lib/

# Compiled Java class files
*.class

# =========================================================
# Penambahan untuk mengabaikan file JasperReports dan Database lokal
# =========================================================

# Jaspersoft Studio Workspace specific files (lokasi default workspace)
# Jika Anda menyimpan proyek Jaspersoft Studio di workspace default, abaikan folder ini
# C:\Users\[NamaUser]\JaspersoftWorkspace\
# (Anda tidak boleh commit seluruh folder workspace Jaspersoft Studio Anda)

# Konfigurasi Data Adapter Jaspersoft Studio yang tersimpan secara global atau di luar proyek
# Jika Anda menyimpan Data Adapter di folder proyek NetBeans Anda, namun tidak ingin di-commit, tambahkan path-nya di sini
# Contoh: Jika Anda menyimpan PostgreSQL_Sekolah_DB.json di src/Report/ atau di root proyek
/src/Report/*.json # Mengabaikan file .json di folder Report
/src/Report/*.xml  # Mengabaikan file .xml di folder Report (jika ada konfigurasi .xml)
/PostgreSQL_Sekolah_DB.json # Jika Anda menyimpannya di root proyek

# File .jasper yang dihasilkan (jika Anda hanya ingin commit .jrxml dan mengompilasinya secara lokal)
# Jika Anda ingin commit file .jasper yang sudah terkompilasi, HAPUS tanda '#' di baris di bawah
# /src/Report/*.jasper